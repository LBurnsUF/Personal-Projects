//------------------------------------ISRs----------------------------------------
// on transaction completion, signal main to fill other half
// and swap immediately to precomputed half to avoid gaps in output
ISR(DMA_CH0_vect){
     bec:	1f 92       	push	r1
     bee:	0f 92       	push	r0
     bf0:	0f b6       	in	r0, 0x3f	; 63
